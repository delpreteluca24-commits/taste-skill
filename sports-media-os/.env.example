# ─────────────────────────────────────────────────────────────────────────────
# Sports Media OS — environment template
# Copy to .env.local (never commit .env.local). Local values: `npx supabase status`
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — public (exposed to the browser by design; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — SERVER ONLY. Bypasses RLS. Used by scripts/ and workers/, never by the web app.
SUPABASE_SECRET_KEY=

# Direct Postgres connection — tests and workers only (local default shown)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI providers — SERVER ONLY. Leave empty to disable a provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI cost control: model per task ("provider:model"). Empty = code default
# (Haiku for discovery/scoring, Sonnet for research/script/fact check).
# Settings → AI overrides these per workspace.
DISCOVERY_MODEL=
SCORING_MODEL=
RESEARCH_MODEL=
SCRIPT_MODEL=
FACT_CHECK_MODEL=
# Optional last-resort fallback for every task, e.g. openai:<model>
AI_FALLBACK_MODEL=
# Optional prices for models not in lib/ai/pricing.ts (USD per 1M tokens), e.g.
# {"my-model":{"input":1,"output":4}}
AI_PRICING_JSON=

# Worker (npm run worker)
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000

# Logging: debug | info | warn | error
LOG_LEVEL=info
