{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Episode",
  "description": "One episode = one idea. Written by Story (03), checked by QC (09) before any spend.",
  "type": "object",
  "required": ["id", "format", "status", "target_age", "idea", "emotion", "beats", "pauses", "audio_mode", "duration_target_s"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^EP[0-9]{3}$"},
    "format": {"enum": ["mini", "episode", "compilation", "sleepy"]},
    "status": {"enum": ["idea", "script", "qc_pre", "approved", "production", "edit", "qc_post", "uploaded_private", "public", "rejected"]},
    "target_age": {"type": "string", "pattern": "^[0-5]-[0-5]$"},
    "idea": {"type": "string", "minLength": 10, "description": "The single idea of the episode (one sentence)"},
    "emotion": {"enum": ["curiosity", "fear_to_courage", "empathy", "joy", "frustration_to_patience", "sadness_to_comfort", "surprise", "calm"]},
    "beats": {
      "type": "object",
      "required": ["hook", "setup", "problem", "attempt", "discovery", "resolution", "payoff"],
      "additionalProperties": {"type": "string", "minLength": 3}
    },
    "pauses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["at_s", "len_s", "prompted_sound"], "properties": {"at_s": {"type": "number", "minimum": 0}, "len_s": {"type": "number", "minimum": 1.5, "maximum": 4}, "prompted_sound": {"type": "string"}}}},
    "audio_mode": {"enum": ["A_no_dialogue", "B_minimal_narrator", "C_minimal_character"]},
    "duration_target_s": {"type": "integer", "minimum": 20, "maximum": 3600},
    "experiment": {"type": "string"},
    "cost_cap_eur": {"type": "number", "minimum": 0},
    "reuse": {"type": "object", "properties": {"video": {"type": "boolean"}, "book": {"type": "boolean"}, "printable": {"type": "boolean"}, "thumbnail": {"type": "boolean"}, "music": {"type": "boolean"}, "merch": {"type": "boolean"}}}
  }
}
