{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset index entry",
  "type": "object",
  "required": ["id", "type", "project", "experiment", "file", "cost_eur", "consistency", "ars", "created"],
  "properties": {
    "id": {"type": "string"},
    "type": {"enum": ["img", "vid", "aud", "mus", "thm", "ref"]},
    "project": {"type": "string"},
    "experiment": {"type": "string"},
    "file": {"type": "string", "description": "repo path or Drive link"},
    "cost_eur": {"type": "number", "minimum": 0},
    "credits": {"type": "number", "minimum": 0},
    "consistency": {"type": "integer", "minimum": 1, "maximum": 5},
    "ars": {"type": "object", "properties": {"video": {"type": "boolean"}, "book": {"type": "boolean"}, "printable": {"type": "boolean"}, "thumbnail": {"type": "boolean"}, "music": {"type": "boolean"}, "merch": {"type": "boolean"}}},
    "created": {"type": "string", "format": "date"}
  }
}
